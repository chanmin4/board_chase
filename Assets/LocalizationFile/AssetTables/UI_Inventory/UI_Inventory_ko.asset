  - m_Id: 620000000015
    m_Localized: "\uC544\uC774\uD15C \uC120\uD0DD"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000016
    m_Localized: "\uC778\uBCA4\uD1A0\uB9AC, \uC0C1\uC810 \uB610\uB294 \uB8E8\uD305 \uC2AC\uB86F\uC744 \uC120\uD0DD\uD558\uBA74 \uC0C1\uC138 \uC815\uBCF4\uAC00 \uD45C\uC2DC\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 620000000017
    m_Localized: "\uB4F1\uB85D\uB41C \uC0C1\uC138 \uC124\uBA85\uC774 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 620000000018
    m_Localized: "\uC124\uBA85"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000019
    m_Localized: "\uC544\uC774\uD15C \uC0C1\uC138"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000020
    m_Localized: "\uC2DC\uB098\uB9AC\uC624 \uBBF8\uB9AC\uBCF4\uAE30\uC6A9\n\n\uD50C\uB808\uC774 \uBAA8\uB4DC\uC5D0\uC11C \uC544\uC774\uD15C\uC744 \uC120\uD0DD\uD558\uBA74 \uC774\uB984, \uC2A4\uD0EF, \uC0C1\uD0DC, \uC124\uBA85\uC774 \uD45C\uC2DC\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 620000000021
    m_Localized: "\uD65C\uC131 \uC0C1\uD0DC \uD6A8\uACFC\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000022
    m_Localized: "\uD50C\uB808\uC774\uC5B4\uC5D0\uAC8C \uC801\uC6A9 \uC911\uC778 \uBC84\uD504\uC640 \uC0C1\uCC98\uAC00 \uC5EC\uAE30\uC5D0 \uD45C\uC2DC\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 620000000023
    m_Localized: "\uBC84\uD504"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000024
    m_Localized: "\uB514\uBC84\uD504"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000025
    m_Localized: "\uC54C \uC218 \uC5C6\uB294 \uC0C1\uD0DC"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000026
    m_Localized: "{0}  {1}  {2:0.0}\uCD08"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000027
    m_Localized: "\uD0A4 \uC2AC\uB86F {0}\uAC1C  •  {1}\uC5F4"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000028
    m_Localized: "\uD0A4\uB97C \uB354\uBE14\uD074\uB9AD\uD558\uBA74 \uC778\uBCA4\uD1A0\uB9AC\uB85C \uB3CC\uC544\uAC11\uB2C8\uB2E4  •  ESC / X: \uB2EB\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000029
    m_Localized: "{0} \uD310\uB9E4"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000030
    m_Localized: "\uAD50\uD658"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000031
    m_Localized: "\uACB0\uC81C \uC624\uB958"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000032
    m_Localized: "\uAD6C\uB9E4 \uACB0\uC81C"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000033
    m_Localized: "\uD68D\uB4DD: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000034
    m_Localized: "\uD22C\uC785 {0}/{1}   •   \uBCF4\uC720 {2}"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000035
    m_Localized: "\uC778\uBCA4\uD1A0\uB9AC \uC544\uC774\uD15C\uC744 \uB354\uBE14\uD074\uB9AD\uD558\uAC70\uB098 \uB9DE\uB294 \uC2AC\uB86F\uC73C\uB85C \uB4DC\uB798\uADF8\uD558\uC138\uC694.\n\uD655\uC778\uC744 \uB204\uB974\uAE30 \uC804\uC5D0\uB294 \uC544\uC774\uD15C\uC774 \uC18C\uBAA8\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 620000000036
    m_Localized: "\uAD50\uD658 \uD655\uC778"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000037
    m_Localized: "\uB0B4\uB824\uB193\uAE30 / \uC624\uB978\uCABD \uD074\uB9AD\uC73C\uB85C \uBE44\uC6B0\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000038
    m_Localized: "\uC7A0\uAE34 \uC0C1\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000039
    m_Localized: "\uD544\uC694 \uD0A4: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000040
    m_Localized: "{0} \uD0A4"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000041
    m_Localized: "\uBE44\uC5B4 \uC788\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000042
    m_Localized: "\uD0A4 {0}/{1}\uAC1C  •  \uD65C\uC131 {2}/{3}  •  \uB0A8\uC740 \uC0AC\uC6A9 \uD69F\uC218 {4}"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000043
    m_Localized: "{0} \uD0A4\n\uC5EC\uAE30\uC5D0 \uB0B4\uB824\uB193\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000044
    m_Localized: "\uD0A4 \uC18C\uCF13\n\uC5EC\uAE30\uB85C \uB4DC\uB798\uADF8\uD558\uAC70\uB098 \uD0A4\uB97C \uB354\uBE14\uD074\uB9AD\uD558\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000045
    m_Localized: "{0} \uD0A4 \uC900\uBE44\n\uD655\uC778\uC744 \uB20C\uB7EC \uC7A0\uAE08 \uD574\uC81C"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000046
    m_Localized: "{0} \uD0A4\n\uD0A4 \uB4F1\uAE09\uC774 \uB2E4\uB985\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000047
    m_Localized: "\uC7A0\uAE08 \uD574\uC81C \uD655\uC778"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000048
    m_Localized: "\uB9DE\uB294 \uD0A4 \uC120\uD0DD"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000049
    m_Localized: "ESC / \uC0C1\uD638\uC791\uC6A9: \uCDE8\uC18C  •  \uD655\uC778\uD558\uAE30 \uC804\uC5D0\uB294 \uD0A4\uAC00 \uC18C\uBAA8\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000050
    m_Localized: "\uC77C\uBC18"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000051
    m_Localized: "\uD76C\uADC0"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000052
    m_Localized: "\uACE0\uC720"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000053
    m_Localized: "\uC804\uC124"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000054
    m_Localized: "\uD0A4 \uD234\uC5D0 \uC0AC\uC6A9 \uAC00\uB2A5\uD55C {0} \uD0A4\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 620000000055
    m_Localized: "{0} \uD0A4\uB97C \uC120\uD0DD\uD588\uC2B5\uB2C8\uB2E4. \uD655\uC778\uC744 \uB20C\uB7EC \uC0AC\uC6A9 \uD69F\uC218 \uD558\uB098\uB97C \uC18C\uBAA8\uD558\uACE0 \uC7A0\uAE08\uC744 \uD574\uC81C\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 620000000056
    m_Localized: "{0} \uD0A4\uB294 \uC774 \uC7A0\uAE08\uC5D0 \uB9DE\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. {1} \uD0A4\uB97C \uC120\uD0DD\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 620000000057
    m_Localized: "\uBA3C\uC800 \uB9DE\uB294 \uD0A4 \uD234 \uD56D\uBAA9\uC744 \uC120\uD0DD\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 620000000058
    m_Localized: "\uC774 \uC7A0\uAE08\uC740 {0} \uD0A4\uB97C \uD544\uC694\uB85C \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 620000000059
    m_Localized: "\uD0A4 \uD234\uC5D0 \uC0AC\uC6A9 \uAC00\uB2A5\uD55C {0} \uD0A4\uAC00 \uB0A8\uC544 \uC788\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 620000000060
    m_Localized: "\uD0A4 \uD234 \uD56D\uBAA9\uC744 \uB4DC\uB798\uADF8\ud558\uAC70\uB098 \uB354\uBE14\ud074\ub9ad\ud55c \ub4a4 \ud655\uc778\uc744 \ub204\ub974\uc138\uc694."
    m_Metadata:
      m_Items: []
  - m_Id: 620000000061
    m_Localized: "\uC784\uBB34"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000062
    m_Localized: "\uC784\uBB34 - {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000063
    m_Localized: "\uC9C4\uD589 \uAC00\uB2A5\uD55C \uC784\uBB34\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4."
