  _unlockNodes:
  - _nodeId: key_normal_purchase
    _displayName: Normal Key Permit
    _description: Granted by the Stage 1 main quest. Unlocks Normal Key purchases
      at the Home shop.
    _prerequisiteNodeIds: []
    _unlockedProductIds:
    - key_normal
    - passive_penetration_barter
  - _nodeId: key_rare_purchase
    _displayName: Rare Key Permit
    _description: Granted by the Stage 2 main quest. Unlocks Rare Key purchases at
      the Home shop.
    _prerequisiteNodeIds:
    - key_normal_purchase
    _unlockedProductIds:
    - key_rare
  - _nodeId: gas_stage_3_preparation
    _displayName: Gas Preparation
    _description: Completing the Stage 2 boss run objective unlocks Infection Cure
      and the Normal gas mask.
    _prerequisiteNodeIds: []
    _unlockedProductIds:
    - infection_cure
    - gas_mask_normal
  - _nodeId: gas_stage_4_filter_upgrade
    _displayName: Gas Filter Upgrade
    _description: Completing the Stage 3 boss run objective unlocks the Rare gas
      mask.
    _prerequisiteNodeIds:
    - gas_stage_3_preparation
    _unlockedProductIds:
    - gas_mask_rare
  - _nodeId: gas_stage_5_filter_upgrade
    _displayName: Advanced Gas Filter
    _description: Completing the Stage 4 boss run objective unlocks Unique and Legendary
      gas masks. These remain rare Home-shop rolls.
    _prerequisiteNodeIds:
    - gas_stage_4_filter_upgrade
    _unlockedProductIds:
    - gas_mask_unique
    - gas_mask_legendary
